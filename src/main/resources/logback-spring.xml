<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <!-- JSON structured log - moi log line la 1 JSON object, san sang day vao ELK/Loki.
         requestId duoc dua vao MDC boi RequestIdFilter va tu dong xuat hien trong moi line JSON. -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <customFields>{"application":"${appName}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>

    <logger name="com.thanhnguyen.ecommercebackend" level="INFO"/>
</configuration>
