spring.application.name=ecommerce-backend

spring.datasource.url=jdbc:postgresql://localhost:5432/ecommerce_db
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME

spring.jpa.hibernate.ddl-auto=validate

jwt.secret=CHANGE_ME_BASE64_SECRET
jwt.access-token-expiration-ms=900000
jwt.refresh-token-expiration-ms=604800000

# Rong theo mac dinh = khong origin nao duoc phep goi API (xem SecurityConfig). Dien origin FE that
# khi co frontend, vd http://localhost:5173 cho Vite — KHONG dung "*" vi allowCredentials(true).
# Placeholder ${CORS_ALLOWED_ORIGINS:} (giong pattern MAIL_HOST/MAIL_PORT o duoi) de docker-compose.yml
# override duoc bang bien CORS_ALLOWED_ORIGINS — property key co dau "-" nen KHONG dung duoc co che tu
# map bien moi truong -> property cua Spring (yeu cau APP_CORS_ALLOWED_ORIGINS, dai va de nham hon).
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:}

# Cloudinary — luu tru anh san pham (POST /api/seller/products/images), dang ky free tier tai
# https://cloudinary.com/users/register/free de lay 3 gia tri nay tu Dashboard.
cloudinary.cloud-name=CHANGE_ME
cloudinary.api-key=CHANGE_ME
cloudinary.api-secret=CHANGE_ME

# Gioi han kich thuoc file anh upload — dat tuong minh thay vi phu thuoc mac dinh an cua Spring (1MB/10MB).
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB


# VNPay sandbox — dang ky merchant test tai https://sandbox.vnpayment.vn/devreg de lay tmn-code/hash-secret that
vnpay.tmn-code=CHANGE_ME
vnpay.hash-secret=CHANGE_ME
vnpay.pay-url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
vnpay.refund-api-url=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
vnpay.return-url=http://localhost:8080/api/payments/vnpay-return

# Notification module — SMTP tro toi Mailhog cho dev (xem docker-compose.yml), doi qua provider that
# o production bang env var MAIL_HOST/MAIL_PORT.
spring.mail.host=${MAIL_HOST:localhost}
spring.mail.port=${MAIL_PORT:1025}
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
notification.mail.from=no-reply@ecommerce.example
management.health.mail.enabled=false

# Payout module — hoa hong flat toan he thong
payout.commission-rate=0.10

# Actuator - /health public (health check cho LB/k8s probe), cac endpoint con lai (metrics, prometheus, info)
# yeu cau ROLE_ADMIN, xem SecurityConfig.
management.endpoints.web.exposure.include=health,info,metrics,prometheus
management.endpoint.health.show-details=never
